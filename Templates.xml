<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Bouton de membre du groupe. "useparent*" permet de lire les actions de clic sur l'en-tête (VuhPlusHeader). -->
	<Button name="VuhPlusUnitTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
		<Size><AbsDimension x="80" y="38"/></Size>
		<Attributes>
			<Attribute name="useparent*" type="boolean" value="true"/>
		</Attributes>
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("AnyUp")
				VuhPlus_InitButton(self)
			</OnLoad>
		</Scripts>
	</Button>
	<!-- Petit cadre de dispel (comme les mini-cadres de Decursive) : un carré par joueur, clic = dissiper.
	     Les actions de clic sont lues sur l'en-tête (useparent*). -->
	<Button name="VuhPlusCureTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
		<Size><AbsDimension x="18" y="18"/></Size>
		<Attributes>
			<Attribute name="useparent*" type="boolean" value="true"/>
		</Attributes>
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("AnyUp")
				VuhPlus_InitCure(self)
			</OnLoad>
		</Scripts>
	</Button>
</Ui>
